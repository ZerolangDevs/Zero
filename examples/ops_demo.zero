// ops_demo.zero - 运算符与表达式求值
import io

a = 10
b = 3

print("a + b = {}\n", a + b)
print("a - b = {}\n", a - b)
print("a * b = {}\n", a * b)
print("a / b = {}\n", a / b)
print("a % b = {}\n", a % b)
print("-a = {}\n", -a)

print("a == b: {}\n", a == b)
print("a != b: {}\n", a != b)
print("a < b: {}\n", a < b)
print("a >= b: {}\n", a >= b)

print("a and b: {}\n", a and b)
print("a or b: {}\n", a or b)
print("!a: {}\n", !a)

name = "Zero"
greeting = "Hello, " + name + "!"
print("{}\n", greeting)

x = 1 + 2 * 3
print("1 + 2 * 3 = {}\n", x)
print("(1 + 2) * 3 = {}\n", (1 + 2) * 3)

y = a > b and a != 0
print("a > b and a != 0: {}\n", y)
