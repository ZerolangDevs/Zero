// strings.zh —— 字符串标准库（Zero 实现，依赖 lowlevel_strings）
// 从 lowlevel_strings 引入基础操作（len / upper / lower / trim / ...），
// 并在此基础上实现 capitalize、countWords、isPalindrome 等高级函数。

import lowlevel_strings
import control

// ---- 基础操作（重新导出自 lowlevel_strings）----
func len(s): zlen(s)
func upper(s): zupper(s)
func lower(s): zlower(s)
func trim(s): ztrim(s)
func contains(s, sub): zcontains(s, sub)
func startswith(s, pre): zstartswith(s, pre)
func endswith(s, suf): zendswith(s, suf)
func is_empty(s): zis_empty(s)
func char_at(s, i): zchar_at(s, i)
func substr(s, start, len): zsubstr(s, start, len)
func replace(s, from, to): zreplace(s, from, to)
func repeat(s, n): zrepeat(s, n)
func reverse(s): zreverse(s)
func index_of(s, sub): zindex_of(s, sub)
func count(s, sub): zcount(s, sub)

// ---- 高级函数 ----

// 首字母大写，其余不变
func capitalize(s): {
    if len(s) == 0:
        return s
    return upper(char_at(s, 0)) + substr(s, 1, len(s) - 1)
}

// 统计由空白分隔的单词数
func count_words(s): {
    n = 0
    in_word = false
    for i in 0..len(s):
        ch = char_at(s, i)
        if ch == " ":
            in_word = false
        else:
            if !in_word:
                n = n + 1
            in_word = true
    return n
}

// 是否为回文
func is_palindrome(s): {
    return s == reverse(s)
}

// 截断：超过 n 个字符时保留前 n 个并追加 "..."
func truncate(s, n): {
    if len(s) <= n:
        return s
    return substr(s, 0, n) + "..."
}

// 移除所有空格
func remove_spaces(s): {
    return replace(s, " ", "")
}
