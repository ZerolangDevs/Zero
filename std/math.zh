// math.zh —— 数学标准库（Zero 实现，依赖 lowlevel_math）
// 从 lowlevel_math 引入基本运算（add / sub / mul / div / rem / neg），
// 并在此基础上实现 abs、max、min、pow、gcd、lcm 等高级函数。

import lowlevel_math
import control

// ---- 基本运算（重新导出自 lowlevel_math）----
func add(a<int>, b<int>) -> int: zadd(a, b)
func sub(a<int>, b<int>) -> int: zsub(a, b)
func mul(a<int>, b<int>) -> int: zmul(a, b)
func div(a<int>, b<int>) -> int: zdiv(a, b)
func rem(a<int>, b<int>) -> int: zrem(a, b)
func neg(a<int>) -> int: zneg(a)

// ---- 高级函数 ----

// 绝对值
func abs(a<int>) -> int: zabs(a)

// 符号：正数 1、零 0、负数 -1
func sign(a<int>) -> int: zsign(a)

// 最大值
func max(a<int>, b<int>) -> int: zmax(a, b)

// 最小值
func min(a<int>, b<int>) -> int: zmin(a, b)

// 钳制到 [lo, hi] 区间
func clamp(x<int>, lo<int>, hi<int>) -> int: zclamp(x, lo, hi)

// 整数幂（exp >= 0 时正确，exp < 0 返回 1）
func pow(base<int>, exp<int>) -> int: zpow(base, exp)

// 阶乘（0! = 1）
func factorial(n<int>) -> int: zfactorial(n)

// 最大公约数（欧几里得算法）
func gcd(a<int>, b<int>) -> int: zgcd(a, b)

// 最小公倍数
func lcm(a<int>, b<int>) -> int: zlcm(a, b)

// 是否为偶数
func is_even(a<int>) -> bool: zis_even(a)

// 是否为奇数
func is_odd(a<int>) -> bool: zis_odd(a)

// 数位之和
func digit_sum(n<int>) -> int: zdigit_sum(n)

// ---- 浮点函数（来自 lowlevel_math）----
func sqrt(a): zsqrt(a)
func floor(a): zfloor(a)
func ceil(a): zceil(a)
func round(a): zround(a)
